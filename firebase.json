{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "BACKUP/**",
      "NEW/**",
      "raw_uploads/**",
      "scripts/**",
      "*.zip",
      "*.xlsx",
      "*.pdf",
      "*.md"
    ],
    "headers": [
      {
        "source": "**/*.@(webp|jpg|jpeg|png|svg|ico|gif|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ]
  }
}
